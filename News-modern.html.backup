            <!-- 2025 News -->
            <div class="bg-white rounded-xl shadow-md p-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b-2 border-primary-500">2025</h2>
                
                <div class="space-y-6">
                    <!-- November 28, 2025 -->
                    <div class="border-l-4 border-gray-200 pl-6 pr-6 hover:bg-gray-50 rounded-lg transition">
                        <div class="flex items-start mb-3">
                            <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 2a2 0 012 2v12a1 1 0 017a2h-12a2 4a2 4.42A2.5a2 6a2.94l.64 6a2.94L6 4.42A2.5a2 6a2.94A2.5a2 6a2.94z"/>
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm text-gray-600 mb-1">November 28, 2025</p>
                                <p class="text-lg font-semibold text-gray-900 mb-2">Welcome professor Junlin Wang from School of Integrated Circuits, Guangdong University of Technology, who shared a lecture on <a href="assets/img/lecture/WangJunlin.jpg" class="text-primary-600 hover:text-primary-700 transition" target="_blank">Atomic-scale simulation of ultrafast spin dynamics in antiferromagnetic materials</a>.</p>
                                <p class="text-gray-700">by <em class="text-primary-700">Commun. Phys.</em>!</p>
                            </div>
                        </div>
                    </div>

                    <!-- October 22, 2025 -->
                    <div class="border-l-4 border-gray-200 pl-6 pr-6 hover:bg-gray-50 rounded-lg transition">
                        <div class="flex items-start mb-3">
                            <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 2a2 0 012 2v12a1 1 0 017a2h-12a2 4a2 4.42A2.5a2 6a2.94l.64 6a2.94L6 4.42A2.5a2 6a2.94z"/>
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm text-gray-600 mb-1">October 22, 2025</p>
                                <p class="text-lg font-semibold text-gray-900 mb-2">Congratulations on acceptance of our paper "Layer-dependent spin-orbit torque switching of Néel vector in a van der Waals antiferromagnet."</p>
                                <p class="text-gray-700">by <em class="text-primary-700">Nat. Commun.</em>!</p>
                            </div>
                        </div>
                    </div>

                    <!-- October 16, 2025 -->
